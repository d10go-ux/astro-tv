{
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" }
      ]
    }
  ],
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "overlay/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "components/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "modules/*.js",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/update", "destination": "/api/update.js" },
    { "source": "/api/state", "destination": "/api/state.js" },
    { "source": "/api/anim", "destination": "/api/anim.js" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
