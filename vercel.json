{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "overlay/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "components/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "modules/*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/update", "dest": "/api/update.js" },
    { "src": "/api/state", "dest": "/api/state.js" },
    { "src": "/api/anim", "dest": "/api/anim.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
